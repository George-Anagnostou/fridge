# Production environment file. Install as /etc/fridge/fridge.env (mode 0600).
# Do not commit a filled-in copy.

COOKIE_SECURE=1
TRUST_PROXY=1
FRIDGE_ADDR=127.0.0.1:8082
FRIDGE_DB=/var/lib/fridge/fridge.db

# Optional: contact appended to the Open Food Facts User-Agent.
OFF_CONTACT=

# Optional: enables the USDA FoodData Central fallback. Leave blank to skip it.
USDA_FDC_API_KEY=

# Optional backup settings (defaults shown in comments).
# FRIDGE_BACKUP_DIR=/var/backups/fridge
# FRIDGE_BACKUP_RETENTION_DAYS=30
# FRIDGE_OFFSITE_DEST=
# FRIDGE_OFFSITE_TOOL=rsync
