# Copy this file to .env.deploy and adjust. .env.deploy is ignored by git.
# One KEY=value per line: no quotes, no spaces, no `export`. Values already
# set in the environment win over this file.

# SSH target. This can be an ~/.ssh/config alias.
FRIDGE_DEPLOY_HOST=kapnizo

# Optional: only when the alias does not set a user.
# FRIDGE_DEPLOY_USER=fridge-deploy

# systemd unit and binary names: fridge (production) or fridge-preview.
FRIDGE_DEPLOY_SERVICE=fridge

# Directory on the server that holds the server and invite binaries.
FRIDGE_DEPLOY_PATH=/usr/local/bin

# Public URL, checked after every deploy and by make verify.
FRIDGE_URL=https://fridge.georgeanagnostou.com
